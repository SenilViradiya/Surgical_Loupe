// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider ="prisma-client-js"
  engineType = "library"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model User {
  id            String    @id @default(cuid())

  name          String?
  email         String    @unique
  password      String?

  image         String?

  role          UserRole  @default(USER)

  emailVerified DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions Session[]

  accounts Account[]
}
model Account {
  id                 String  @id @default(cuid())
  userId             String

  type               String
  provider           String
  providerAccountId  String

  refresh_token      String? @db.Text
  access_token       String? @db.Text

  expires_at         Int?

  token_type         String?
  scope              String?

  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())

  sessionToken String   @unique

  userId       String

  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
}
enum ProductStatus {
  ACTIVE
  INACTIVE
}
enum LeadStatus {
  PENDING
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}
enum UserRole {
  ADMIN
  DEALER
  USER
}
model Frame {
  id            String          @id @default(cuid())

  name          String
  slug          String          @unique

  description   String?

  thumbnailUrl  String?

  modelUrl      String

  price         Float

  status        ProductStatus   @default(ACTIVE)

  configurations Configuration[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}
model Lens {
  id            String          @id @default(cuid())

  name          String
  slug          String          @unique

  description   String?

  thumbnailUrl  String?

  magnification String

  price         Float

  status        ProductStatus   @default(ACTIVE)

  configurations Configuration[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}
model Headlight {
  id            String          @id @default(cuid())

  name          String
  slug          String          @unique

  description   String?

  thumbnailUrl  String?

  modelUrl      String?

  price         Float

  status        ProductStatus   @default(ACTIVE)

  configurations Configuration[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
}
model Dealer {
  id          String    @id @default(cuid())

  name        String

  email       String    @unique

  phone       String

  city        String
  state       String

  isActive    Boolean   @default(true)

  coverages   DealerCoverage[]

  leads       Lead[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
model DealerCoverage {
  id          String   @id @default(cuid())

  pincode     String

  dealerId    String

  dealer      Dealer   @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@unique([dealerId, pincode])
  @@index([pincode])
}
model Configuration {
  id            String      @id @default(cuid())

  frameId        String
  lensId         String
  headlightId    String?

  frame          Frame       @relation(fields: [frameId], references: [id])

  lens           Lens        @relation(fields: [lensId], references: [id])

  headlight      Headlight?  @relation(fields: [headlightId], references: [id])

  lead           Lead?

  createdAt      DateTime    @default(now())
}
model Lead {
  id               String       @id @default(cuid())

  fullName         String

  email            String

  phone            String

  city             String
  state            String
  pincode          String

  notes            String?

  status           LeadStatus   @default(PENDING)

  dealerId         String?

  configurationId  String       @unique

  dealer           Dealer?      @relation(fields: [dealerId], references: [id])

  configuration    Configuration @relation(fields: [configurationId], references: [id])

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([email])
  @@index([status])
  @@index([dealerId])
}
model Event {
  id            String    @id @default(cuid())

  title         String

  slug          String    @unique

  description   String?

  thumbnailUrl  String?

  location      String

  startDate     DateTime

  endDate       DateTime

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  
}
