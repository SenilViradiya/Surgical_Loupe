// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
  output     = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  name     String?
  email    String  @unique
  password String?

  image String?

  role UserRole @default(USER)

  emailVerified DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]

  accounts Account[]

  notifications Notification[]
}

model Account {
  id     String @id @default(cuid())
  userId String

  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text

  expires_at Int?

  token_type String?
  scope      String?

  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id String @id @default(cuid())

  sessionToken String @unique

  userId String

  expires DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
}

enum LeadStatus {
  PENDING
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum QuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum UserRole {
  ADMIN
  DEALER
  USER
}

enum NotificationType {
  LEAD
  QUOTE
  INVENTORY
  DEALER
  SYSTEM
}

enum DealerOnboardingStatus {
  INVITED
  PENDING_SETUP
  ACTIVE
  SUSPENDED
}

model Frame {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?

  thumbnailUrl String?

  modelUrl String

  price Float

  status ProductStatus @default(ACTIVE)

  configurations Configuration[]

  frameLensCompatibilities      FrameLensCompatibility[]
  frameHeadlightCompatibilities FrameHeadlightCompatibility[]
  inventory                     FrameInventory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model FrameInventory {
  id                String          @id @default(cuid())
  frameId           String          @unique
  quantity          Int             @default(0)
  reserved          Int             @default(0)
  lowStockThreshold Int             @default(5)
  status            InventoryStatus @default(IN_STOCK)

  frame Frame @relation(fields: [frameId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([frameId])
}

model Lens {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?

  thumbnailUrl String?

  modelUrl String?

  magnification String

  price Float

  status ProductStatus @default(ACTIVE)

  configurations Configuration[]

  frameLensCompatibilities     FrameLensCompatibility[]
  lensHeadlightCompatibilities LensHeadlightCompatibility[]
  inventory                    LensInventory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model LensInventory {
  id                String          @id @default(cuid())
  lensId            String          @unique
  quantity          Int             @default(0)
  reserved          Int             @default(0)
  lowStockThreshold Int             @default(5)
  status            InventoryStatus @default(IN_STOCK)

  lens Lens @relation(fields: [lensId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([lensId])
}

model Headlight {
  id String @id @default(cuid())

  name String
  slug String @unique

  description String?

  thumbnailUrl String?

  modelUrl String?

  price Float

  status ProductStatus @default(ACTIVE)

  configurations Configuration[]

  frameHeadlightCompatibilities FrameHeadlightCompatibility[]
  lensHeadlightCompatibilities  LensHeadlightCompatibility[]
  inventory                     HeadlightInventory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model HeadlightInventory {
  id                String          @id @default(cuid())
  headlightId       String          @unique
  quantity          Int             @default(0)
  reserved          Int             @default(0)
  lowStockThreshold Int             @default(5)
  status            InventoryStatus @default(IN_STOCK)

  headlight Headlight @relation(fields: [headlightId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([headlightId])
}

model Dealer {
  id String @id @default(cuid())

  name String

  email String @unique

  onboardingStatus DealerOnboardingStatus @default(ACTIVE)

  inviteToken String? @unique

  inviteTokenExpiresAt DateTime?

  profileCompletedAt DateTime?

  companyName String?

  businessDetails String?

  address String?

  serviceRegions String?

  phone String

  city  String
  state String

  isActive Boolean @default(true)

  coverages DealerCoverage[]

  leads Lead[]

  quotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DealerCoverage {
  id String @id @default(cuid())

  pincode String

  dealerId String

  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([dealerId, pincode])
  @@index([pincode])
}

model Configuration {
  id String @id @default(cuid())

  frameId     String
  lensId      String
  headlightId String?

  frame Frame @relation(fields: [frameId], references: [id])

  lens Lens @relation(fields: [lensId], references: [id])

  headlight Headlight? @relation(fields: [headlightId], references: [id])

  lead Lead?

  createdAt DateTime @default(now())
}

model Notification {
  id String @id @default(cuid())

  userId String

  title String
  message String

  type NotificationType

  isRead Boolean @default(false)

  entityType String?
  entityId String?

  metadata Json?

  deliveryChannel String @default("IN_APP")
  deliveryStatus String @default("PENDING")

  eventKey String @unique

  readAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
  @@index([entityType, entityId])
}

model FrameLensCompatibility {
  id String @id @default(cuid())

  frameId String
  lensId  String
  reason  String?

  frame Frame @relation(fields: [frameId], references: [id], onDelete: Cascade)
  lens  Lens  @relation(fields: [lensId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([frameId, lensId])
  @@index([frameId])
  @@index([lensId])
}

model FrameHeadlightCompatibility {
  id String @id @default(cuid())

  frameId     String
  headlightId String
  reason      String?

  frame     Frame     @relation(fields: [frameId], references: [id], onDelete: Cascade)
  headlight Headlight @relation(fields: [headlightId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([frameId, headlightId])
  @@index([frameId])
  @@index([headlightId])
}

model LensHeadlightCompatibility {
  id String @id @default(cuid())

  lensId      String
  headlightId String
  reason      String?

  lens      Lens      @relation(fields: [lensId], references: [id], onDelete: Cascade)
  headlight Headlight @relation(fields: [headlightId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([lensId, headlightId])
  @@index([lensId])
  @@index([headlightId])
}

model Lead {
  id String @id @default(cuid())

  fullName String

  email String

  phone String

  city    String
  state   String
  pincode String

  notes String?

  status LeadStatus @default(PENDING)

  dealerId String?

  configurationId String @unique

  dealer Dealer? @relation(fields: [dealerId], references: [id])

  configuration Configuration @relation(fields: [configurationId], references: [id])

  quotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([dealerId])
}

model Quote {
  id String @id @default(cuid())

  quoteNumber String @unique

  leadId   String
  dealerId String

  status QuoteStatus @default(DRAFT)

  subtotal Decimal @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  notes String?

  expiresAt DateTime

  sentAt      DateTime?
  viewedAt    DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  convertedAt DateTime?

  customerToken          String   @unique
  customerTokenExpiresAt DateTime

  sentToEmail String
  pdfUrl      String?

  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dealer Dealer @relation(fields: [dealerId], references: [id], onDelete: Restrict)

  items         QuoteItem[]
  history       QuoteHistory[]
  notifications QuoteNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadId])
  @@index([dealerId, status])
  @@index([status, expiresAt])
  @@index([createdAt])
}

model QuoteItem {
  id String @id @default(cuid())

  quoteId String

  productType String
  productId   String
  productName String

  price     Decimal @db.Decimal(12, 2)
  quantity  Int     @default(1)
  sortOrder Int     @default(0)
  metadata  Json?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([quoteId])
  @@index([productType, productId])
}

model QuoteHistory {
  id String @id @default(cuid())

  quoteId String

  event      String
  status     QuoteStatus?
  comment    String?
  actorType  String?
  actorId    String?
  actorEmail String?
  metadata   Json?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([event])
}

model QuoteNotification {
  id String @id @default(cuid())

  quoteId String

  event             String
  channel           String
  deliveryStatus    String
  recipient         String?
  providerMessageId String?
  payload           Json?

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([quoteId, createdAt])
  @@index([event, channel])
}

model Event {
  id String @id @default(cuid())

  title String

  slug String @unique

  description String?

  thumbnailUrl String?

  location String

  startDate DateTime

  endDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id String @id @default(cuid())

  action String

  entityType String

  entityId String

  description String?

  userEmail String?

  createdAt DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}
